# Copia este archivo como .env (cp .env.example .env) y reemplaza los valores.

# Microsoft Entra ID: registro de la API "hotel-bff-admin" en el directorio Hotel (HotelOficial.onmicrosoft.com).
# Ambos microservicios validan que el token traiga este tenant (issuer) y este client ID (audience).
# No son secretos: son identificadores públicos que aparecen en cada token.
ENTRA_TENANT_ID=6fab43c1-0dda-4aaf-a237-a21fec7f41b6
ENTRA_API_CLIENT_ID=45f37289-341f-499a-b942-b769bbf68527

# MySQL del contenedor (no se expone fuera de Docker).
MYSQL_ROOT_PASSWORD=cambia-esta-clave
MYSQL_PASSWORD=cambia-esta-otra-clave

# AWS Cognito (opcional): solo lo usan las rutas /api/v1/users/guest del frontend de huéspedes.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# RabbitMQ: usuario y clave del broker (panel en http://localhost:15672).
RABBITMQ_USER=hotel
RABBITMQ_PASSWORD=cambia-esta-clave-de-rabbit

# hotel-ms-rabbitmq-admin exige el app role ADMIN en el token. Pon "false" mientras no estén asignados en Entra ID.
ENTRA_EXIGIR_ROL=true

# SMTP real (opcional). Por defecto los correos van a Mailpit: http://localhost:8025
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
